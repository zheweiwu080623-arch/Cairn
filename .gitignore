# ---- 依赖与构建产物（不进仓库）----
node_modules/
__pycache__/
*.pyc
*.pyo
shell/dist/
shell/sdk/
*.exe
*.dll

# ---- 本地运行数据（数据库 / 日志 / 缓存 / 导出 / 本地备份）----
data/
*.log
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# ---- 改名前的备份与快照（保留在你本机，不进仓库）----
*.bak-*
*.snapshot-*
*.bak
*.old

# ---- 个人素材（体积大 / 版权不明；要用就自己放回这个目录）----
public/assets/wallpapers/
public/assets/kotei_avatar.jpg

# ---- 凭据（永不入库）----
secrets.env
.env
.env.local
*.pem
*.key

# ---- 编辑器与系统文件 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
